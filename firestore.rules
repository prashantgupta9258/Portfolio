rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128;
    }

    match /projects/{projectId} {
      allow read: if true;
      allow create, update: if isValidId(projectId)
        && request.resource.data is map
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 500;
      allow delete: if isValidId(projectId);
    }

    match /siteSettings/{settingId} {
      allow read: if true;
      allow create, update: if isValidId(settingId)
        && request.resource.data is map;
      allow delete: if isValidId(settingId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
